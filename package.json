{
  "name": "@lilbunnyrabbit/agtc",
  "version": "0.1.1",
  "description": "Agent Traffic Control: air traffic control for your coding agents. Terminal dashboard for local Claude Code and Codex sessions.",
  "keywords": [
    "claude-code",
    "codex",
    "agents",
    "tui",
    "dashboard",
    "worktree",
    "bun"
  ],
  "homepage": "https://github.com/lilBunnyRabbit/agtc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lilBunnyRabbit/agtc.git"
  },
  "bugs": {
    "url": "https://github.com/lilBunnyRabbit/agtc/issues"
  },
  "license": "MIT",
  "author": "lilBunnyRabbit",
  "type": "module",
  "bin": {
    "agtc": "bin/agtc"
  },
  "files": [
    "src",
    "bin/agtc"
  ],
  "engines": {
    "bun": ">=1.1"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "start": "bun src/main.ts",
    "check": "bunx tsc --noEmit",
    "check:offline": "sh scripts/verify-offline.sh",
    "smoke": "bun src/main.ts --json > /dev/null"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "bun-types": "^1.4.2"
  }
}
